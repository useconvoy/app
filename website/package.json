{
  "name": "@convoy/website",
  "version": "0.1.0",
  "private": true,
  "description": "Convoy console, BFF, and identity/commerce layer",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:lexicon": "node scripts/check-lexicon.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "generate:client": "node scripts/generate-client.mjs",
    "check:client-drift": "node scripts/generate-client.mjs --check",
    "db:migrate": "node scripts/migrate.mjs",
    "notifier": "tsx src/notifier/main.ts",
    "verify": "npm run typecheck && npm run lint && npm run check:lexicon && npm run check:tokens && npm run test"
  },
  "dependencies": {
    "@workos-inc/node": "^10.9.0",
    "jose": "^6.2.8",
    "next": "^16.3.0",
    "openapi-fetch": "^0.17.0",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "stripe": "^22.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "axe-core": "^4.12.1",
    "eslint": "^10.8.0",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
