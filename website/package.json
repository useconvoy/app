{
  "name": "@convoy/website",
  "version": "0.1.0",
  "private": true,
  "description": "Convoy landing page: deployment infrastructure for physical AI",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:tokens": "node scripts/check-tokens.mjs",
