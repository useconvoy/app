{
  "components": {
    "schemas": {
      "ApprovePlanRequest": {
        "description": "Approve or reject the plan version awaiting approval. The version pin\nguarantees the decision targets the plan the human actually reviewed;\nrejections must say why.",
        "properties": {
          "approve": {
            "default": true,
            "title": "Approve",
            "type": "boolean"
          },
          "plan_version": {
            "minimum": 1.0,
            "title": "Plan Version",
            "type": "integer"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "required": [
          "plan_version"
        ],
        "title": "ApprovePlanRequest",
        "type": "object"
      },
      "BudgetView": {
        "properties": {
          "cap_usd": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cap Usd"
          },
          "reserved_usd": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reserved Usd"
          },
          "spent_usd": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spent Usd"
          }
        },
        "title": "BudgetView",
        "type": "object"
      },
      "ClockAdvanceRequest": {
        "description": "Move a virtual-clock rehearsal run's time forward to `to`\n(timezone-aware, or it is rejected).",
        "properties": {
          "to": {
            "format": "date-time",
            "title": "To",
            "type": "string"
          }
        },
        "required": [
          "to"
        ],
        "title": "ClockAdvanceRequest",
        "type": "object"
      },
      "CreateRunRequest": {
        "properties": {
          "budget_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "default": "10",
            "title": "Budget Usd"
          },
          "environment_id": {
            "default": "stub-local",
            "title": "Environment Id",
            "type": "string"
          },
          "fixture_fanout": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FanoutFixture"
              },
              {
                "type": "null"
              }
            ]
          },
          "fixture_gates": {
            "additionalProperties": {
              "$ref": "#/components/schemas/HumanGate"
            },
            "default": {},
            "title": "Fixture Gates",
            "type": "object"
          },
          "goal": {
            "minLength": 1,
            "title": "Goal",
            "type": "string"
          },
          "max_children": {
            "default": 5,
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Max Children",
            "type": "integer"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "policy": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RunPolicy"
              },
              {
                "type": "null"
              }
            ]
          },
          "run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run Id"
          },
          "success_criteria": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Success Criteria",
            "type": "array"
          },
          "tools": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Tools",
            "type": "array"
          }
        },
        "required": [
          "goal"
        ],
        "title": "CreateRunRequest",
        "type": "object"
      },
      "CreateRunResponse": {
        "properties": {
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "status"
        ],
        "title": "CreateRunResponse",
        "type": "object"
      },
      "FanoutFixture": {
        "description": "Fixture-plan fan-out request: a group of `size` subagent members\nbetween the investigate step and the summarize step (which becomes the\njoin). Members carry `budget_slice` as their reservation and are marked\noptional so a tolerated member failure still lands as a valid partial\ncompletion; the join stays required. `child_layer` exists so tests can\ncraft depth-guard violations.",
        "properties": {
          "budget_slice": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Budget Slice"
          },
          "child_layer": {
            "default": 1,
            "title": "Child Layer",
            "type": "integer"
          },
          "size": {
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Size",
            "type": "integer"
          }
        },
        "required": [
          "size"
        ],
        "title": "FanoutFixture",
        "type": "object"
      },
      "GateRespondRequest": {
        "description": "Answer one step's open human gate. `at_virtual` scripts a simulated\nhuman on virtual-clock rehearsal runs: the answer is delivered when\nvirtual time reaches that instant (timezone-aware, or it is rejected).",
        "properties": {
          "at_virtual": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "At Virtual"
          },
          "response": {
            "minLength": 1,
            "title": "Response",
            "type": "string"
          }
        },
        "required": [
          "response"
        ],
        "title": "GateRespondRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HumanGate": {
        "properties": {
          "kind": {
            "enum": [
              "approval",
              "input",
              "action"
            ],
            "title": "Kind",
            "type": "string"
          },
          "on_timeout": {
            "default": "pause",
            "enum": [
              "pause",
              "skip",
              "fail"
            ],
            "title": "On Timeout",
            "type": "string"
          },
          "prompt": {
            "title": "Prompt",
            "type": "string"
          },
          "timeout": {
            "anyOf": [
              {
                "format": "duration",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timeout"
          }
        },
        "required": [
          "kind",
          "prompt"
        ],
        "title": "HumanGate",
        "type": "object"
      },
      "RunPolicy": {
        "properties": {
          "approval_scope": {
            "default": "major_revisions",
            "enum": [
              "initial",
              "major_revisions",
              "all_revisions"
            ],
            "title": "Approval Scope",
            "type": "string"
          },
          "max_depth": {
            "default": 1,
            "title": "Max Depth",
            "type": "integer"
          },
          "max_parallel": {
            "default": 5,
            "title": "Max Parallel",
            "type": "integer"
          },
          "max_steps": {
            "default": 50,
            "title": "Max Steps",
            "type": "integer"
          },
          "on_budget_exhausted": {
            "default": "pause",
            "enum": [
              "pause",
              "land",
              "abort"
            ],
            "title": "On Budget Exhausted",
            "type": "string"
          },
          "on_group_partial_failure": {
            "default": "join_with_partials",
            "enum": [
              "join_with_partials",
              "block_on_human",
              "fail_group"
            ],
            "title": "On Group Partial Failure",
            "type": "string"
          },
          "plan_shape": {
            "default": "linear_fanout",
            "enum": [
              "linear",
              "linear_fanout",
              "dag"
            ],
            "title": "Plan Shape",
            "type": "string"
          },
          "require_plan_approval": {
            "default": true,
            "title": "Require Plan Approval",
            "type": "boolean"
          }
        },
        "title": "RunPolicy",
        "type": "object"
      },
      "RunView": {
        "description": "Served from Postgres projections only \u2014 never from Temporal. Subagent\nchild runs are rows of their own, linked back by `parent_run_id`.",
        "properties": {
          "budget": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BudgetView"
              },
              {
                "type": "null"
              }
            ]
          },
          "goal": {
            "title": "Goal",
            "type": "string"
          },
          "land_report": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Land Report"
          },
          "parent_run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Run Id"
          },
          "plan": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Plan"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "steps": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/StepView"
            },
            "title": "Steps",
            "type": "array"
          },
          "tenant_id": {
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "tenant_id",
          "status",
          "goal"
        ],
        "title": "RunView",
        "type": "object"
      },
      "SignalResponse": {
        "properties": {
          "accepted": {
            "default": true,
            "title": "Accepted",
            "type": "boolean"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "signal": {
            "title": "Signal",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "signal"
        ],
        "title": "SignalResponse",
        "type": "object"
      },
      "SteerRequest": {
        "description": "A steer for the run's mailbox: a note rides into the next turn's\ncontext; a redirect additionally forces the agent to assess the plan\nagainst it.",
        "properties": {
          "body": {
            "minLength": 1,
            "title": "Body",
            "type": "string"
          },
          "mode": {
            "enum": [
              "note",
              "redirect"
            ],
            "title": "Mode",
            "type": "string"
          }
        },
        "required": [
          "mode",
          "body"
        ],
        "title": "SteerRequest",
        "type": "object"
      },
      "SteerResponse": {
        "properties": {
          "accepted": {
            "default": true,
            "title": "Accepted",
            "type": "boolean"
          },
          "mode": {
            "enum": [
              "note",
              "redirect"
            ],
            "title": "Mode",
            "type": "string"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "steer_id": {
            "title": "Steer Id",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "steer_id",
          "mode"
        ],
        "title": "SteerResponse",
        "type": "object"
      },
      "StepView": {
        "properties": {
          "attempt": {
            "default": 0,
            "title": "Attempt",
            "type": "integer"
          },
          "cost_usd": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cost Usd"
          },
          "description": {
            "default": "",
            "title": "Description",
            "type": "string"
          },
          "model_used": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Used"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "step_id": {
            "title": "Step Id",
            "type": "string"
          },
          "updated_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          }
        },
        "required": [
          "step_id",
          "status"
        ],
        "title": "StepView",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Convoy Agent Runtime",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/runs": {
      "post": {
        "operationId": "create_run_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateRunResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Run"
      }
    },
    "/runs/{run_id}": {
      "get": {
        "operationId": "get_run_runs__run_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Run"
      }
    },
    "/runs/{run_id}/clock/advance": {
      "post": {
        "description": "Fast-forward a rehearsal run's virtual clock, resolving every virtual\ntimer with a deadline at or before the target. Guarded twice: only\nsandbox-kind bindings running a virtual clock accept advances (the\nworkflow re-checks and drops anything else), and time never moves\nbackward. The advance is an audited external mutation \u2014 the signal\ncarries the verified actor, and the events its resolved timers emit\nattribute it.",
        "operationId": "advance_clock_runs__run_id__clock_advance_post",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClockAdvanceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignalResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Advance Clock"
      }
    },
    "/runs/{run_id}/events": {
      "get": {
        "operationId": "stream_events_runs__run_id__events_get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "default": 0,
              "title": "After",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Stream Events"
      }
    },
    "/runs/{run_id}/land": {
      "post": {
        "operationId": "land_run_runs__run_id__land_post",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignalResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Land Run"
      }
    },
    "/runs/{run_id}/pause": {
      "post": {
        "operationId": "pause_run_runs__run_id__pause_post",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignalResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Pause Run"
      }
    },
    "/runs/{run_id}/plan/approve": {
      "post": {
        "description": "Approve or reject the plan version awaiting approval. The supplied\nversion must match the live plan so decisions can never target a plan\nthe human did not review; the workflow re-checks and drops mismatches.",
        "operationId": "approve_plan_runs__run_id__plan_approve_post",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprovePlanRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignalResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Approve Plan"
      }
    },
    "/runs/{run_id}/resume": {
      "post": {
        "operationId": "resume_run_runs__run_id__resume_post",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignalResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Resume Run"
      }
    },
    "/runs/{run_id}/steer": {
      "post": {
        "description": "Append one steer to the run's mailbox; the workflow loop drains it\ninto the next turn.",
        "operationId": "steer_run_runs__run_id__steer_post",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SteerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
