# Convoy landing page. Copy to .env.local for development.

# Public origin, used for canonical URLs and link-preview images.
NEXT_PUBLIC_SITE_URL=https://deployconvoy.com

# Contact delivery. The form is served in a preview state until a verified
# destination exists: submissions are validated, never acknowledged as
# received, and never stored. Set both values once the receiving inbox and
# the sending provider have been chosen; see README.md.
# CONTACT_DELIVERY=      # provider id, once implemented in src/lib/contact/delivery.ts
# CONTACT_TO_EMAIL=      # the receiving inbox
