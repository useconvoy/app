# Website environment. Copy to .env.local for development.

# Session signing secret (32+ characters).
SESSION_SECRET=change-me-to-a-long-random-value-please

# Website Postgres. The app role is RLS-bound; the admin DSN is used only by
# migrations. With the runtime's local stack up (`make e2e-up`), the website
# database lives on the same Postgres instance.
WEBSITE_PG_DSN=postgresql://convoy_website_app:convoy_website_app@localhost:5433/convoy_website
WEBSITE_PG_ADMIN_DSN=postgresql://convoy_admin:convoy_admin@localhost:5433/convoy_website

# Control plane (the single authenticated edge) and the bridge bearer.
CONVOY_CONTROL_PLANE_URL=http://localhost:8700
CONVOY_CONTROL_PLANE_TOKEN=e2e-dev-token

# WorkOS AuthKit. Leave unset for the local dev sign-in provider.
# WORKOS_API_KEY=
# WORKOS_CLIENT_ID=

# Stripe (invoice-first billing). Leave unset to disable billing surfaces.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
