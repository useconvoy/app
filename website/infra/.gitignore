# Terraform working files — state must live in the encrypted S3 backend, never in git.
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*.tfplan

# Real per-console variable files may contain account specifics; only the
# committed fixtures/example.tfvars template belongs in git. The runbook has
# operators write <name>.tfvars, so the pattern has to cover every tfvars name
# rather than just the two Terraform loads automatically.
*.tfvars
!fixtures/example.tfvars
