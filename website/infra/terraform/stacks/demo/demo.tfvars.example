# Copy to demo.tfvars (gitignored by infra/.gitignore's *.tfvars rule) and fill.
#
#   terraform init -plugin-dir="$HOME/.convoy-tf-mirror"
#   terraform plan -var-file=demo.tfvars -out=stamp.tfplan

region      = "us-west-2"
stack_name  = "demo"
environment = "demo"

domain_name       = "deployconvoy.com"
availability_zone = "us-west-2a"

# Placeholder — no runtime stack exists yet. The console's marketing and
# sign-in surfaces work; run, plan, and workspace surfaces will not.
control_plane_url = "https://api.deployconvoy.com"

# Omit control_plane_token to have the stack generate one. Nothing validates
# it while the control plane is a placeholder.

# WorkOS staging. Omit both to deploy with sign-in disabled.
workos_api_key   = "sk_test_..."
workos_client_id = "client_01KZA115MPR4WX9QTWC0JSCA0B"

image_tag = "bootstrap"
