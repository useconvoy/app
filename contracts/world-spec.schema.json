{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://useconvoy.dev/contracts/world-spec.v1alpha1.schema.json",
  "title": "Convoy WorldSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "scenario",
    "services",
    "human_actors",
    "tools",
    "evaluation"
  ],
  "properties": {
    "apiVersion": {
      "const": "convoy.ai/v1alpha1"
    },
    "kind": {
      "const": "World"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "description"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,62}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "instruction"],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "instruction": {
          "type": "string"
        }
      }
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "local_provider", "production_candidates"],
        "properties": {
          "capability": {
            "type": "string"
          },
          "local_provider": {
            "type": "string"
          },
          "production_candidates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "human_actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "policies": {
      "type": "object"
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z]+\\.[a-z_]+$"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "pass_score"],
      "properties": {
        "module": {
          "type": "string",
          "pattern": "^\\./"
        },
        "pass_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    }
  }
}
