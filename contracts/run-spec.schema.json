{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://useconvoy.dev/contracts/run-spec.v1alpha1.schema.json",
  "title": "Convoy RunSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "runtime", "world", "artifacts"],
  "properties": {
    "apiVersion": {
      "const": "convoy.ai/v1alpha1"
    },
    "kind": {
      "const": "Run"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mission_id"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,62}$"
        },
        "mission_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 128
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executor",
        "image",
        "command",
        "timeout_seconds",
        "resources",
        "network"
      ],
      "properties": {
        "executor": {
          "enum": ["local-docker", "agentcore", "ecs-ec2", "firecracker"]
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 28800
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu", "memory_mb", "pids"],
          "properties": {
            "cpu": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 64
            },
            "memory_mb": {
              "type": "integer",
              "minimum": 128,
              "maximum": 262144
            },
            "pids": {
              "type": "integer",
              "minimum": 16,
              "maximum": 32768
            }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "allowed_hosts"],
          "properties": {
            "mode": {
              "enum": ["world-only", "restricted-egress", "open-egress", "none"]
            },
            "allowed_hosts": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "image", "scenario_actions"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,62}$"
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "scenario_actions": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "secrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source", "reference"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "source": {
            "enum": ["aws-secrets-manager", "ssm-parameter", "local-env"]
          },
          "reference": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths", "retention_days"],
      "properties": {
        "paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/convoy/output/"
          }
        },
        "retention_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        }
      }
    }
  }
}
