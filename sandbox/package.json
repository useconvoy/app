{
  "name": "convoy-sandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "providers/*",
    "adapters/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node apps/sandbox-control-plane/src/server.mjs",
    "test": "node --test tests/*.test.mjs && node tests/http.integration.mjs && node tests/convoy-connectors.integration.mjs",
    "test:official": "node tests/official-contracts.mjs",
    "demo": "node examples/demo.mjs"
  }
}
