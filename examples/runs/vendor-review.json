{
  "apiVersion": "convoy.ai/v1alpha1",
  "kind": "Run",
  "metadata": {
    "id": "vendor-demo-001",
    "mission_id": "enterprise-vendor-security-review",
    "labels": {
      "customer": "aurelia-cloud",
      "environment": "demo"
    }
  },
  "runtime": {
    "executor": "local-docker",
    "image": "convoy/agent-runtime:dev",
    "command": ["node", "/opt/convoy/mock-agent.mjs"],
    "timeout_seconds": 180,
    "resources": {
      "cpu": 1,
      "memory_mb": 512,
      "pids": 128
    },
    "network": {
      "mode": "world-only",
      "allowed_hosts": ["world"]
    },
    "environment": {
      "CONVOY_AGENT_MODE": "deterministic-replay"
    }
  },
  "world": {
    "id": "aurelia-vendor-review",
    "image": "convoy/world-runtime:dev",
    "scenario_actions": "worlds/catalog/aurelia-vendor-review/successful-run.json"
  },
  "secrets": [],
  "artifacts": {
    "paths": [
      "/convoy/output/events.jsonl",
      "/convoy/output/result.json"
    ],
    "retention_days": 30
  }
}
